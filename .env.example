# Template for .env — committed. Contains NO real keys.
#
#   cp .env.example .env      # then fill in .env, never this file
#
# .env is gitignored (.gitignore: `.env`, `*.env`). If you ever find a real
# key in THIS file, it has been committed and pushed: rotate that key
# immediately, don't just delete the line.
#
# Inspect AI auto-loads .env from the directory you run `inspect eval` in.

# --- API keys ----------------------------------------------------------------
# Only the provider(s) you actually use need a value; leave the rest empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
# --- Azure AI Foundry — non-OpenAI catalog (azureai/ provider) ---------------
AZUREAI_API_KEY=
AZUREAI_BASE_URL=

# --- Inspect AI defaults (optional) ------------------------------------------
# Default model when a task doesn't specify one, e.g. openai/gpt-5.2
INSPECT_EVAL_MODEL=

# Where .eval logs are written (default: ./logs)
INSPECT_LOG_DIR=

# Log format: eval (default, compact zip) or json
INSPECT_LOG_FORMAT=

# Azure OpenAI (distinct from AZUREAI_* above, which is Azure AI Foundry)
AZUREAI_OPENAI_API_KEY=
AZUREAI_OPENAI_BASE_URL=
AZUREAI_OPENAI_API_VERSION=
